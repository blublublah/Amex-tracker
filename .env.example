# Public URL of the deployed app (no trailing slash). Used in emails, calendar feed and OAuth redirects.
BASE_URL=http://localhost:3000
PORT=3000
# Where the SQLite database lives. Mount a persistent disk here in production.
DATA_DIR=./data
# Random string used to encrypt stored Gmail tokens. Generate: openssl rand -hex 32
SECRET_KEY=

# --- Email reminders (any SMTP provider: Resend, Postmark, SendGrid, Gmail app password, ...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Platinum Credit Tracker <reminders@yourdomain.com>"

# --- Optional: Gmail detection (Google Cloud OAuth client, redirect URI = BASE_URL/api/gmail/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
